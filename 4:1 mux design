// Design a 4:1 mux
module mux4_1(
  input [3:0] i0,
  input [3:0] i1,
  input [3:0] i2,
  input [3:0] i3,
  input  [1:0] sel,
  output reg [3:0] y
  
);
  always@(*)
    begin
      case(sel)
        2'b00 : y=i0;
        2'b01 : y=i1;
        2'b10 : y=i2;
        2'b11 : y=i3;
        default : y=4'b0000;
      endcase
    end
endmodule
          
        
  

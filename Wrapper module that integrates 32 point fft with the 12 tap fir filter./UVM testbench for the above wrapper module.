class my_scoreboard extends uvm_scoreboard;
    `uvm_component_utils(my_scoreboard)
 
    uvm_analysis_imp #(my_sequence_item, my_scoreboard) item_export;
    
    int prediction_pipe[$]; 
    int unsigned mag_history[11];
    int bin_history_pipe[$];
    
    shortint current_fft_r[32];
    shortint current_fft_i[32];
    
    const int B[12] = '{-150, -200, 100, 1500, 3500, 4800, 4800, 3500, 1500, 100, -200, -150};
  
    real SAMPLING_RATE = 8000.0;
    int  TOTAL_BINS    = 32;

    function new(string name = "my_scoreboard", uvm_component parent = null);
        super.new(name, parent);
        item_export = new("item_export", this);
        foreach(mag_history[i]) mag_history[i] = 0;
    endfunction

    // --- The Main Write Function ---
    virtual function void write(my_sequence_item item);
        complex_t dft_res[32]; 
        string frame_report;
        
        reference_dft(item.tb_in_r, item.tb_in_i, dft_res);
        
        frame_report = $sformatf("\n--- FFT FRAME AT TIME %0t ---\n", $time);
        frame_report = {frame_report, $sformatf("%-5s | %-12s | %10s | %12s | %-10s\n", 
                       "Bin", "Frequency", "Act Mag", "Exp Mag", "Zone")};
        frame_report = {frame_report, "------------------------------------------------------------\n"};

        for (int i = 0; i < 32; i++) begin
            current_fft_r[i] = shortint'($signed(int'(dft_res[i].re)) >>> 5);
            current_fft_i[i] = shortint'($signed(int'(dft_res[i].im)) >>> 5);
            
            // Call the silent version to build the string
            predict_and_compare_silent(i, current_fft_r, current_fft_i, item.frame_smoothed_mag[i], frame_report);
        end

        `uvm_info("SCB_FRAME", frame_report, UVM_LOW)
    endfunction

    // --- The Silent Prediction Logic ---
    virtual function void predict_and_compare_silent(
        bit [4:0] bin_cnt,
        shortint  fft_r[32],
        shortint  fft_i[32],
        shortint  rtl_act,
        ref string report  // Use 'ref' to modify the string from the write function
    );
        bit [4:0] rev_idx;
        longint   immediate_sum;
        int       expected_val;
        bit [15:0] abs_r, abs_i, max_v, min_v, magnitude_in;
        real      freq;  
        string    zone;

        // Bit-reversal for Bin indexing if your hardware uses it
        rev_idx = {bin_cnt[0], bin_cnt[1], bin_cnt[2], bin_cnt[3], bin_cnt[4]};
      
        abs_r = (fft_r[rev_idx] < 0) ? -fft_r[rev_idx] : fft_r[rev_idx];
        abs_i = (fft_i[rev_idx] < 0) ? -fft_i[rev_idx] : fft_i[rev_idx];
        max_v = (abs_r > abs_i) ? abs_r : abs_i;
        min_v = (abs_r > abs_i) ? abs_i : abs_r;

        // Alpha-Max plus Beta-Min Magnitude Approximation
        magnitude_in = shortint'(max_v + (min_v >> 2) + (min_v >> 3));

        // FIR Filter Logic
        immediate_sum = longint'($signed(magnitude_in) * $signed(B[0]));
        for (int i = 0; i < 11; i++) begin
            immediate_sum += longint'($signed(mag_history[i]) * $signed(B[i+1]));
        end

        expected_val = int'($signed(immediate_sum) >>> 13);
        if (expected_val < 0)      expected_val = 0;
        if (expected_val > 32767)  expected_val = 32767;

        // Shift History
        for (int i = 10; i > 0; i--) mag_history[i] = mag_history[i-1];
        mag_history[0] = magnitude_in;

        freq = bin_cnt * (SAMPLING_RATE / TOTAL_BINS);
        zone = get_zone_label(freq);

        // Append this bin's data to the report
        report = {report, $sformatf("%-5d | %-12.2f | %10d | %12d | %-10s\n", 
                  bin_cnt, freq, rtl_act, expected_val, zone)};
    endfunction

    function string get_zone_label(real freq);
        if (freq < 1000.0) return "LOW";
        if (freq < 2500.0) return "MID";
        return "HIGH";
    endfunction
endclass

// --- Test ---
class my_test extends uvm_test;
  `uvm_component_utils(my_test)

  my_environment env;

  function new(string name = "my_test", uvm_component parent = null);
    super.new(name, parent);
  endfunction

  virtual function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    env = my_environment::type_id::create("env", this);
  endfunction

  task run_phase(uvm_phase phase);
    // Create the specialized sequence
    master_sequence seq = master_sequence::type_id::create("seq");
    
    phase.raise_objection(this);
   `uvm_info("TEST_TOP", "Starting Master Sequence (Randomized Input)", UVM_LOW)
    
    // Test 1: Sending a single tone aligned to Bin 4 (1000 Hz)
    // This helps check for spectral leakage and pipeline alignment.
    
    
    seq.start(env.agent.sequencer);

    // Optional: Add a small delay to let the last frame clear the pipeline
    #100ns;

    phase.drop_objection(this);
  endtask
endclass

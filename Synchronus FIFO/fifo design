// Designing a synchronus FIFO
module fifo_8_8(
  input clk, rst, wr_en, rd_en,
  input[7:0] d_in, 
  output reg [7:0] d_out,
  output full, empty
);
  reg[2:0] wr_ptr=0; 
  reg[2:0] rd_ptr=0;
  reg[7:0] mem[0:7];
  integer i ;
  assign full =((wr_ptr+1'b1) ==rd_ptr);
  assign empty= wr_ptr== rd_ptr;
  
  always @(posedge clk)
    begin 
      if (rst)
        begin
          for(i=0;i<7; i=i+1)
            mem[i]<=0;
        end
        
      else if(wr_en && full==0)
        begin
          mem[wr_ptr]<=d_in;
          wr_ptr      <= wr_ptr + 1'b1;
       end
      
      else if(rd_en && empty==0)
        begin
          d_out<= mem[rd_ptr];
          rd_ptr<=rd_ptr+1'b1;
        end
    end
  
endmodule
         
         
        
  

module fifo_8_8_tb;
  reg clk, rst, wr_en, rd_en;
  reg[7:0] d_in;
  wire[7:0] d_out;
  wire full, empty;
  
  fifo_8_8 uut(
    .clk(clk),
    .rst(rst),
    .wr_en(wr_en),
    .rd_en(rd_en),
    .d_in(d_in),
    .d_out(d_out),
    .full(full),
    .empty(empty)
  );
  always #5 clk = ~clk;
    initial begin
        $dumpfile("fifo_waveform.vcd");  
        $dumpvars(0, fifo_8_8_tb); 
       end
  initial
    begin
        clk = 0;rst = 1;wr_en = 0;rd_en = 0;d_in = 0;
    end
  
  initial
    begin
      rst=1;
      #10;
      rst=0;
      wr_en=1;
      d_in=5;
      #10 
      wr_en=1;
      d_in=10;
      #10
      wr_en=0;
      #10
      rd_en=1'b1;
      #10
      $finish;
      
    end 
endmodule
  

  reg [3:0] tb_i1;
  reg [3:0] tb_i2;
  reg [3:0] tb_i3;
  reg [1:0] tb_sel;
  wire [3:0] tb_y;
  
  mux4_1 uut(
    .i0(tb_i0),
    .i1(tb_i1),
    .i2( tb_i2),
    .i3(tb_i3),
    .sel(tb_sel),
    .y(tb_y)

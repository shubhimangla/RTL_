    real bin_freq;
   
   // Declaring inputs for DUT
   reg signed [15:0] tb_in_r[0:31];
   reg signed [15:0] tb_in_i[0:31]; 
   // Declaring outputs for DUT
   wire signed [15:0] tb_out_r[0:31], tb_out_i[0:31];
   wire is_low, is_mid, is_high;
   
   // Declaring the function for bit reversal operation
   function [4:0] bit_reversal;
     input [4:0] index;
     integer k;
     begin
     for(k=0; k<5; k=k+1)
       begin
         bit_reversal[4-k]=index[k];
         end
     end
   endfunction
   fft_32pt_top uut (
     .in_r(tb_in_r),
     .in_i(tb_in_i),
     .out_r(tb_out_r),
     .out_i(tb_out_i),
     .is_low_freq(is_low),   // Connect the hardware flag to the TB wire
     .is_mid_freq(is_mid),   // Connect the hardware flag to the TB wire
     .is_high_freq(is_high)  // Connect the hardware flag to the TB wire

);
   
   integer i; 
   integer rev_indx;
   real mag;

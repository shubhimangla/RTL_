// Testbench for 8 point FFT
`timescale 1ns / 1ps
 module fft_32_pt_tb;
   parameter real FS = 1000.0;       // Define your Sampling Frequency here (e.g., 1000Hz)
    parameter integer N = 32;         // Number of FFT points
    parameter real BIN_WIDTH = FS/N;    //Frequency Resolution
